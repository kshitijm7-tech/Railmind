# F01 — Frontend API integration configuration
# Copy to .env.local for local development.

# Backend origin (FastAPI). Default: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Integration mode: auto | real | mock (default: auto)
# - auto: use the real backend when reachable, mock fallback for offline dev
# - real: strict backend integration (no silent mock fallback)
# - mock: deterministic fixtures only
NEXT_PUBLIC_API_MODE=auto

# Request timeout in milliseconds (default: 10000)
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Set to "true" for dev-only request diagnostics (never logs secrets)
NEXT_PUBLIC_API_DEBUG=false
